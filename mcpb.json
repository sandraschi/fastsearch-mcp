{
  "name": "fastsearch-mcp",
  "version": "0.4.0",
  "description": "Lightning-fast file search for Claude Desktop using direct NTFS Master File Table access",
  "author": "sandraschi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandraschi/fastsearch-mcp.git"
  },
  "outputDir": "dist",
  "mcp": {
    "version": "2.13.0",
    "server": {
      "command": "python",
      "args": ["-m", "fastsearch_mcp"],
      "transport": "stdio"
    },
    "capabilities": {
      "tools": true,
      "resources": false,
      "prompts": true
    }
  },
  "dependencies": {
    "python": ">=3.8,<4.0",
    "fastmcp": ">=2.13.0",
    "pydantic": ">=2.0.0",
    "psutil": ">=5.9.0",
    "pywin32": ">=306"
  },
  "build": {
    "include": [
      "src/fastsearch_mcp/**/*.py",
      "README.md",
      "LICENSE",
      "prompts/**/*"
    ],
    "exclude": [
      "__pycache__",
      "*.pyc",
      "*.pyo",
      ".pytest_cache",
      ".mypy_cache",
      ".vscode",
      ".github",
      "tests",
      "venv",
      ".git",
      "*.md",
      "docs"
    ]
  }
}

