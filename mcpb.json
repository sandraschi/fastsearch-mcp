{
  "name": "fastsearch-mcp",
  "version": "1.1.0",
  "type": "server",
  "runtime": "python",
  "entry_point": "src/fastsearch_mcp/server.py",
  "dependencies": [
    "fastmcp>=3.2.0,<4"
  ],
  "build": {
    "include": [
      "src/**/*",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      ".git/",
      "__pycache__/",
      "*.pyc",
      ".venv/",
      "dist/",
      "build/",
      "target/",
      "docs/",
      "scripts/",
      "mcpb/"
    ]
  },
  "scripts": {
    "build": "mcpb build",
    "pack": "mcpb pack . dist/fastsearch-mcp.mcpb",
    "test": "python -m pytest"
  }
}