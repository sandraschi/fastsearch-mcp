<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" 
           Name="FastSearch MCP" 
           Manufacturer="FastSearch" 
           Version="2.0.0"
           UpgradeCode="3298de23-b4e3-481e-91f7-ddcb238b95b4"
           Language="1033">
    
    <Package InstallerVersion="500" 
             Compressed="yes" 
             InstallScope="perMachine"
             Description="FastSearch MCP - High-performance NTFS file search with Claude Desktop integration"
             Comments="FastSearch MCP provides lightning-fast file search using direct NTFS MFT access via C++ service with Python MCP bridge"
             InstallPrivileges="elevated" />
             
    <MajorUpgrade DowngradeErrorMessage="A newer version of FastSearch MCP is already installed." />
    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />
    
    <!-- Set installation directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="FastSearch MCP" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="FastSearch MCP"/>
      </Directory>
    </Directory>

    <!-- Application files -->
    <Feature Id="ProductFeature" Title="FastSearch MCP" Level="1">
      <ComponentRef Id="CppServiceBinary" />
      <ComponentRef Id="PythonMCPBridge" />
      <ComponentRef Id="ServiceInstall" />
      <ComponentRef Id="PowerShellScripts" />
      <ComponentRef Id="Documentation" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <!-- UI Configuration -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start FastSearch Service" />
    
    <!-- Service Configuration -->
    <Property Id="SERVICENAME" Value="FastSearchMCP" />
    <Property Id="SERVICEDISPLAYNAME" Value="FastSearch MCP Service" />
    <Property Id="SERVICEDESCRIPTION" Value="Provides high-performance NTFS file search capabilities using direct MFT access" />
    
    <!-- Service Control -->
    <CustomAction Id="StartService" 
                 FileKey="FastSearchServiceExe" 
                 ExeCommand='--start' 
                 Execute="deferred" 
                 Return="ignore" 
                 Impersonate="no" />
    
    <CustomAction Id="StopService" 
                 FileKey="FastSearchServiceExe" 
                 ExeCommand='--stop' 
                 Execute="deferred" 
                 Return="ignore" 
                 Impersonate="no" />
    
    <InstallExecuteSequence>
      <!-- Stop service during uninstall -->
      <Custom Action="StopService" Before="RemoveFiles">
        (NOT UPGRADINGPRODUCTCODE) AND (REMOVE~="ALL")
      </Custom>
      
      <!-- Start service after install -->
      <Custom Action="StartService" After="InstallFinalize">
        NOT Installed AND NOT WIX_UPGRADE_DETECTED
      </Custom>
    </InstallExecuteSequence>

    <!-- UI Configuration -->
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="wix\\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="wix\\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="wix\\dialogbg.bmp" />
    
    <!-- Custom Actions -->
    <CustomAction Id="LaunchServiceControl" 
                  FileKey="ServiceControlScript" 
                  ExeCommand="" 
                  Return="asyncNoWait" />
                  
    <UI>
      <Publish Dialog="ExitDialog" 
               Control="Finish" 
               Event="DoAction" 
               Value="LaunchServiceControl">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
    </UI>

    <!-- Files -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- C++ Service Binary -->
      <Component Id="CppServiceBinary" Guid="*">
        <File Id="FastSearchServiceExe" 
              Source="$(var.SolutionDir)service\build\bin\Release\FastSearchServiceNew.exe" 
              KeyPath="yes" />
      </Component>
      
      <!-- Python MCP Bridge -->
      <Component Id="PythonMCPBridge" Guid="*">
        <File Id="MCPBridgePy" 
              Source="$(var.SolutionDir)src\fastsearch_mcp\server.py" 
              KeyPath="yes" />
        <File Id="MCPBridgeInit" 
              Source="$(var.SolutionDir)src\fastsearch_mcp\__init__.py" />
        <File Id="ServiceClientPy" 
              Source="$(var.SolutionDir)src\fastsearch_mcp\service_client.py" />
        <File Id="LoggingConfigPy" 
              Source="$(var.SolutionDir)src\fastsearch_mcp\logging_config.py" />
        <File Id="UtilsInit" 
              Source="$(var.SolutionDir)src\fastsearch_mcp\utils\__init__.py" />
        <File Id="FileUtilsPy" 
              Source="$(var.SolutionDir)src\fastsearch_mcp\utils\file_utils.py" />
      </Component>
      
      <!-- PowerShell Management Scripts -->
      <Component Id="PowerShellScripts" Guid="*">
        <File Id="InstallServicePs1" 
              Source="$(var.SolutionDir)install-service.ps1" 
              KeyPath="yes" />
        <File Id="FixServicePs1" 
              Source="$(var.SolutionDir)fix-service.ps1" />
        <File Id="TestServicePs1" 
              Source="$(var.SolutionDir)test-service.ps1" />
        <File Id="TestServiceStartupPs1" 
              Source="$(var.SolutionDir)test-service-startup.ps1" />
        <File Id="TestWindowsServicePs1" 
              Source="$(var.SolutionDir)test-windows-service.ps1" />
      </Component>
      
      <!-- Service Installation -->
      <Component Id="ServiceInstall" Guid="*">
        <ServiceInstall 
          Id="ServiceInstaller" 
          Type="ownProcess"
          Vital="yes"
          Name="$(var.SERVICENAME)"
          DisplayName="$(var.SERVICEDISPLAYNAME)"
          Description="$(var.SERVICEDESCRIPTION)"
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal"
          Interactive="no">
          <ServiceDependency Id="tcpip" />
        </ServiceInstall>
        
        <ServiceControl 
          Id="StartService" 
          Name="$(var.SERVICENAME)" 
          Start="install" 
          Stop="both" 
          Remove="uninstall" 
          Wait="yes" />
      </Component>
      
      <!-- Service Control Script -->
      <Component Id="ServiceControlScript" Guid="*">
        <File Id="ServiceControlBat" 
              Source="$(var.SolutionDir)service-control.bat" 
              KeyPath="yes" />
      </Component>
      
      <!-- Start Menu Shortcuts -->
      <Component Id="StartMenuShortcuts" Guid="*">
        <Shortcut Id="StartMenuServiceControl" 
                 Name="Service Control" 
                 Description="Manage FastSearch Service"
                 Target="[INSTALLFOLDER]service-control.bat"
                 WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="StartMenuReadme" 
                 Name="Readme" 
                 Target="[INSTALLFOLDER]README.md" />
        <RegistryValue Root="HKCU" 
                      Key="Software\FastSearch\MCP" 
                      Name="Installed" 
                      Type="integer" 
                      Value="1" 
                      KeyPath="yes" />
      </Component>
      
      <!-- Documentation -->
      <Component Id="Documentation" Guid="*">
        <File Id="Readme" 
              Source="$(var.SolutionDir)README.md" 
              KeyPath="yes" />
        <File Id="License" 
              Source="$(var.SolutionDir)LICENSE" />
        <File Id="Changelog" 
              Source="$(var.SolutionDir)docs\CHANGELOG.md" />
        <File Id="ServiceStatus" 
              Source="$(var.SolutionDir)docs\SERVICE_DEVELOPMENT_STATUS.md" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
