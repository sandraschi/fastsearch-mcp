<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="FastSearch MCP" 
          Version="2.0.0.0" 
          Manufacturer="FastSearch" 
          UpgradeCode="3298de23-b4e3-481e-91f7-ddcb238b95b4"
          IconSourceFile="$(var.SolutionDir)assets\icon.ico">
    
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtlLicense">
      <bal:WixStandardBootstrapperApplication 
        LicenseFile="$(var.SolutionDir)wix\license.rtf"
        LogoFile="$(var.SolutionDir)assets\banner.bmp"
        SuppressOptionsUI="yes"
        SuppressRepair="yes"
        SuppressDowngradeFailure="yes"
        SuppressMissingSourceOrLoggedDataFailure="yes"
        SuppressOptionsUI="yes"
        ThemeFile="$(var.SolutionDir)wix\theme.xml"
        />
    </BootstrapperApplicationRef>

    <!-- Check for Python 3.8 or later -->
    <util:RegistrySearch 
      Root="HKLM"
      Key="SOFTWARE\Python\PythonCore\3.8\InstallPath"
      Value=""
      Variable="PythonPath"
      Result="exists"
      Format="raw" />

    <util:RegistrySearch 
      Root="HKLM"
      Key="SOFTWARE\Python\PythonCore\3.9\InstallPath"
      Value=""
      Variable="PythonPath39"
      Result="exists"
      Format="raw" />

    <util:RegistrySearch 
      Root="HKLM"
      Key="SOFTWARE\Python\PythonCore\3.10\InstallPath"
      Value=""
      Variable="PythonPath310"
      Result="exists"
      Format="raw" />

    <util:RegistrySearch 
      Root="HKLM"
      Key="SOFTWARE\Python\PythonCore\3.11\InstallPath"
      Value=""
      Variable="PythonPath311"
      Result="exists"
      Format="raw" />

    <util:RegistrySearch 
      Root="HKLM"
      Key="SOFTWARE\Python\PythonCore\3.12\InstallPath"
      Value=""
      Variable="PythonPath312"
      Result="exists"
      Format="raw" />

    <Chain>
      <!-- Install Python 3.8+ if needed -->
      <ExePackage Id="PythonInstaller"
                  DisplayName="Python 3.8+ Runtime"
                  Cache="yes"
                  Compressed="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  SourceFile="$(var.SolutionDir)redist\python-3.11.0-amd64.exe"
                  DownloadUrl="https://www.python.org/ftp/python/3.11.0/python-3.11.0-amd64.exe"
                  InstallCommand="/quiet InstallAllUsers=1 PrependPath=1 Include_test=0"
                  DetectCondition="PythonPath OR PythonPath39 OR PythonPath310 OR PythonPath311 OR PythonPath312">
        <ExitCode Behavior="success" Value="0" />
        <ExitCode Behavior="error" Value="3010" /> <!-- Reboot required -->
      </ExePackage>

      <!-- Install Visual C++ Redistributable -->
      <ExePackage Id="VCRedist"
                  DisplayName="Microsoft Visual C++ Redistributable"
                  Cache="yes"
                  Compressed="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  SourceFile="$(var.SolutionDir)redist\vc_redist.x64.exe"
                  DownloadUrl="https://aka.ms/vs/17/release/vc_redist.x64.exe"
                  InstallCommand="/quiet /norestart"
                  DetectCondition="VersionNT >= v6.0">
        <ExitCode Behavior="success" Value="0" />
        <ExitCode Behavior="error" Value="3010" /> <!-- Reboot required -->
      </ExePackage>

      <!-- Main MSI package -->
      <MsiPackage 
        SourceFile="$(var.SolutionDir)installer\FastSearchMCP.msi"
        DisplayInternalUI="yes"
        Vital="yes"
        Id="FastSearchMCP"
        Compressed="yes"
        Cache="yes">
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
